// Ptex Management Dashboard — Prisma schema
// Switch DB providers by changing the `provider` line below.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  MANAGER
  ADMIN
  SUPER_ADMIN
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  password     String
  role         Role     @default(EMPLOYEE)
  employeeCode String   @unique
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  timesheets  Timesheet[]
  sessions    Session[]
  auditLogs   AuditLog[]
  misReports  MISReport[]      @relation("MISCreator")
  permissions UserPermission[]

  timesheetComments        TimesheetComment[]        @relation("CommentAuthor")
  timesheetMentions        TimesheetCommentMention[] @relation("MentionedUser")
  timesheetQueriesOpened   TimesheetQuery[]          @relation("QueryOpenedBy")
  timesheetQueriesResolved TimesheetQuery[]          @relation("QueryResolvedBy")
}

enum MasterType {
  TYPE
  CLIENT
  PRODUCT
  VERSION
  MODULE
  CLOUD_ON_PREM
}

model Master {
  id          Int        @id @default(autoincrement())
  type        MasterType
  code        String
  description String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  activitiesAsClient  Activity[]     @relation("ActivityClient")
  activitiesAsType    Activity[]     @relation("ActivityType")
  activitiesAsProduct Activity[]     @relation("ActivityProduct")
  activitiesAsVersion Activity[]     @relation("ActivityVersion")
  activitiesAsModule  Activity[]     @relation("ActivityModule")
  activitiesAsCloud   Activity[]     @relation("ActivityCloud")
  timesheets          Timesheet[]    @relation("TimesheetClient")
  sandboxRows         SandboxEntry[] @relation("SandboxClient")

  @@unique([type, code])
  @@index([type])
}

model ActivitySequence {
  id      Int @id @default(1)
  current Int @default(4389) // next issued = current + 1
}

model Activity {
  id         Int    @id @default(autoincrement())
  activityId String @unique // e.g. STC.ALL.CR.1.0.4390
  seq        Int    @unique // 4390, 4391, ...
  name       String // free-text description, e.g. "SUMM Cloud Development"

  clientId      Int
  client        Master  @relation("ActivityClient", fields: [clientId], references: [id])
  typeId        Int
  type          Master  @relation("ActivityType", fields: [typeId], references: [id])
  productId     Int
  product       Master  @relation("ActivityProduct", fields: [productId], references: [id])
  versionId     Int
  version       Master  @relation("ActivityVersion", fields: [versionId], references: [id])
  moduleId      Int
  module        Master  @relation("ActivityModule", fields: [moduleId], references: [id])
  cloudOnPremId Int?
  cloudOnPrem   Master? @relation("ActivityCloud", fields: [cloudOnPremId], references: [id])

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks          Task[]
  timesheets     Timesheet[]
  sandboxEntries SandboxEntry[] @relation("SandboxActivity")

  @@index([clientId])
  @@index([typeId])
}

model Task {
  id         Int      @id @default(autoincrement())
  taskId     String
  taskName   String
  poRef      String?
  activityId Int
  activity   Activity @relation(fields: [activityId], references: [id])
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  timesheets Timesheet[]

  @@index([activityId])
}

model Timesheet {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  clientId    Int
  client      Master   @relation("TimesheetClient", fields: [clientId], references: [id])
  activityId  Int
  activity    Activity @relation(fields: [activityId], references: [id])
  taskId      Int
  task        Task     @relation(fields: [taskId], references: [id])
  date        DateTime
  weekNo      Int
  weekLabel   String
  description String   @db.Text
  hours       Decimal  @db.Decimal(5, 2)
  minutes     Int
  type        String

  sat Decimal @default(0) @db.Decimal(5, 2)
  sun Decimal @default(0) @db.Decimal(5, 2)
  mon Decimal @default(0) @db.Decimal(5, 2)
  tue Decimal @default(0) @db.Decimal(5, 2)
  wed Decimal @default(0) @db.Decimal(5, 2)
  thu Decimal @default(0) @db.Decimal(5, 2)
  fri Decimal @default(0) @db.Decimal(5, 2)

  status        TimesheetStatus @default(DRAFT)
  submittedAt   DateTime?
  approvedAt    DateTime?
  rejectionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sandboxEntries SandboxEntry[]
  // Staff-only discussion; kept in separate tables so employee-facing
  // timesheet queries never load them.
  query          TimesheetQuery?
  comments       TimesheetComment[]

  @@index([userId])
  @@index([date])
  @@index([status])
  @@index([clientId])
  @@index([activityId])
}

model SandboxEntry {
  id          Int        @id @default(autoincrement())
  originalId  Int?
  original    Timesheet? @relation(fields: [originalId], references: [id])
  userId      Int
  clientId    Int
  client      Master     @relation("SandboxClient", fields: [clientId], references: [id])
  activityId  Int
  activity    Activity   @relation("SandboxActivity", fields: [activityId], references: [id])
  taskId      Int
  date        DateTime
  weekNo      Int
  weekLabel   String
  description String     @db.Text
  hours       Decimal    @db.Decimal(5, 2)
  minutes     Int
  type        String

  sat Decimal @default(0) @db.Decimal(5, 2)
  sun Decimal @default(0) @db.Decimal(5, 2)
  mon Decimal @default(0) @db.Decimal(5, 2)
  tue Decimal @default(0) @db.Decimal(5, 2)
  wed Decimal @default(0) @db.Decimal(5, 2)
  thu Decimal @default(0) @db.Decimal(5, 2)
  fri Decimal @default(0) @db.Decimal(5, 2)

  sandboxLabel String
  isDeleted    Boolean  @default(false)
  isAdded      Boolean  @default(false)
  isModified   Boolean  @default(false)
  managerNote  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sandboxLabel])
  @@index([userId])
  @@index([clientId])
  @@index([activityId])
}

model MISReport {
  id           Int      @id @default(autoincrement())
  title        String
  periodStart  DateTime
  periodEnd    DateTime
  sandboxLabel String?
  isFinal      Boolean  @default(false)
  createdById  Int
  createdBy    User     @relation("MISCreator", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  data         Json

  @@index([createdById])
  @@index([periodStart, periodEnd])
}

model UserPermission {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    String
  action    String
  granted   Boolean
  updatedAt DateTime @updatedAt

  @@unique([userId, module, action])
  @@index([userId])
}

model Session {
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

enum QueryStatus {
  OPEN
  RESOLVED
}

// Internal (staff-only) query on a timesheet entry. Posting a comment opens
// it; "Query Resolved" closes it; a later comment reopens it.
model TimesheetQuery {
  timesheetId  Int         @id
  timesheet    Timesheet   @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  status       QueryStatus @default(OPEN)
  openedById   Int
  openedBy     User        @relation("QueryOpenedBy", fields: [openedById], references: [id])
  openedAt     DateTime    @default(now())
  resolvedById Int?
  resolvedBy   User?       @relation("QueryResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt   DateTime?
  updatedAt    DateTime    @updatedAt

  @@index([status])
}

model TimesheetComment {
  id          Int                       @id @default(autoincrement())
  timesheetId Int
  timesheet   Timesheet                 @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  authorId    Int
  author      User                      @relation("CommentAuthor", fields: [authorId], references: [id])
  body        String                    @db.Text
  createdAt   DateTime                  @default(now())
  mentions    TimesheetCommentMention[]

  @@index([timesheetId])
}

model TimesheetCommentMention {
  commentId Int
  comment   TimesheetComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    Int
  user      User             @relation("MentionedUser", fields: [userId], references: [id])

  @@id([commentId, userId])
  @@index([userId])
}
