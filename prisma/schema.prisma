// Ptex Management Dashboard — Prisma schema
// Switch DB providers by changing the `provider` line below.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  MANAGER
  ADMIN
  SUPER_ADMIN
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  password     String
  role         Role     @default(EMPLOYEE)
  employeeCode String   @unique
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  timesheets  Timesheet[]
  sessions    Session[]
  auditLogs   AuditLog[]
  misReports  MISReport[]      @relation("MISCreator")
  permissions UserPermission[]

  timesheetComments        TimesheetComment[]        @relation("CommentAuthor")
  timesheetMentions        TimesheetCommentMention[] @relation("MentionedUser")
  timesheetQueriesOpened   TimesheetQuery[]          @relation("QueryOpenedBy")
  timesheetQueriesResolved TimesheetQuery[]          @relation("QueryResolvedBy")

  contractsCreated    Contract[]       @relation("ContractCreator")
  activityMemberships ActivityMember[]
}

enum MasterType {
  TYPE
  CLIENT
  PRODUCT
  VERSION
  MODULE
  CLOUD_ON_PREM
  CURRENCY // contract currency (GBP, INR, USD…)
  RESOURCE_TYPE // commercial billing role (TC, LC…) — unrelated to the RBAC Role enum
  TASK // generic task catalogue that SOW scope lines pick from
}

model Master {
  id          Int        @id @default(autoincrement())
  type        MasterType
  code        String
  description String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  activitiesAsClient  Activity[]     @relation("ActivityClient")
  activitiesAsType    Activity[]     @relation("ActivityType")
  activitiesAsProduct Activity[]     @relation("ActivityProduct")
  activitiesAsVersion Activity[]     @relation("ActivityVersion")
  activitiesAsModule  Activity[]     @relation("ActivityModule")
  activitiesAsCloud   Activity[]     @relation("ActivityCloud")
  timesheets          Timesheet[]    @relation("TimesheetClient")
  sandboxRows         SandboxEntry[] @relation("SandboxClient")

  contractsAsClient    Contract[]           @relation("ContractClient")
  contractsAsCurrency  Contract[]           @relation("ContractCurrency")
  contractRates        ContractRate[]       @relation("ContractRateResource")
  contractTasks        ContractTask[]       @relation("ContractTaskMaster")
  contractTaskBudgets  ContractTaskBudget[] @relation("ContractBudgetResource")
  activityMembers      ActivityMember[]     @relation("ActivityMemberResource")
  timesheetsAsResource Timesheet[]          @relation("TimesheetResourceType")

  @@unique([type, code])
  @@index([type])
}

enum ContractStatus {
  DRAFT
  ACTIVE
  CLOSED
}

// Contract / SOW: the commercial source of truth for rates, scope and budget.
// Totals are never stored — lib/contract-calc.ts derives them from rates ×
// budget hours on read. The code doubles as the PO reference in MIS output.
model Contract {
  id          Int            @id @default(autoincrement())
  code        String         @unique
  description String?        @db.Text
  clientId    Int
  client      Master         @relation("ContractClient", fields: [clientId], references: [id])
  currencyId  Int
  currency    Master         @relation("ContractCurrency", fields: [currencyId], references: [id])
  status      ContractStatus @default(DRAFT)
  activatedAt DateTime?
  closedAt    DateTime?
  createdById Int
  createdBy   User           @relation("ContractCreator", fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  rates      ContractRate[]
  tasks      ContractTask[]
  activities Activity[]

  @@index([clientId])
  @@index([status])
}

// Agreed hourly rate per commercial role (RESOURCE_TYPE master), in the
// contract's currency.
model ContractRate {
  id             Int      @id @default(autoincrement())
  contractId     Int
  contract       Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  resourceTypeId Int
  resourceType   Master   @relation("ContractRateResource", fields: [resourceTypeId], references: [id])
  ratePerHour    Decimal  @db.Decimal(12, 2)

  @@unique([contractId, resourceTypeId])
}

// A task (TASK master) in the SOW's scope. Activities pick their tasks from
// these rows; one SOW task may be delivered through several Activities and
// they all consume the same budget.
model ContractTask {
  id           Int      @id @default(autoincrement())
  contractId   Int
  contract     Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  taskMasterId Int
  taskMaster   Master   @relation("ContractTaskMaster", fields: [taskMasterId], references: [id])
  sortOrder    Int      @default(0)

  budgets       ContractTaskBudget[]
  activityTasks Task[]

  @@unique([contractId, taskMasterId])
}

// Budgeted hours for one SOW task and one role. Only roles present in the
// contract's rate table are allowed (enforced in lib/contract-service.ts).
model ContractTaskBudget {
  contractTaskId Int
  contractTask   ContractTask @relation(fields: [contractTaskId], references: [id], onDelete: Cascade)
  resourceTypeId Int
  resourceType   Master       @relation("ContractBudgetResource", fields: [resourceTypeId], references: [id])
  hours          Decimal      @db.Decimal(10, 2)

  @@id([contractTaskId, resourceTypeId])
  @@index([resourceTypeId])
}

model ActivitySequence {
  id      Int @id @default(1)
  current Int @default(4389) // next issued = current + 1
}

model Activity {
  id         Int    @id @default(autoincrement())
  activityId String @unique // e.g. STC.ALL.CR.1.0.4390
  seq        Int    @unique // 4390, 4391, ...
  name       String // free-text description, e.g. "SUMM Cloud Development"

  clientId      Int
  client        Master  @relation("ActivityClient", fields: [clientId], references: [id])
  typeId        Int
  type          Master  @relation("ActivityType", fields: [typeId], references: [id])
  productId     Int
  product       Master  @relation("ActivityProduct", fields: [productId], references: [id])
  versionId     Int
  version       Master  @relation("ActivityVersion", fields: [versionId], references: [id])
  moduleId      Int
  module        Master  @relation("ActivityModule", fields: [moduleId], references: [id])
  cloudOnPremId Int?
  cloudOnPrem   Master? @relation("ActivityCloud", fields: [cloudOnPremId], references: [id])

  // Season 2: the SOW this Activity executes. Nullable only for rows created
  // before contracts existed; the API requires it for new Activities.
  contractId Int?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: Restrict)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks          Task[]
  members        ActivityMember[]
  timesheets     Timesheet[]
  sandboxEntries SandboxEntry[]   @relation("SandboxActivity")

  @@index([clientId])
  @@index([typeId])
  @@index([contractId])
}

// Who may log time on an Activity, and at which commercial role (a
// RESOURCE_TYPE that has a rate on the Activity's contract).
model ActivityMember {
  activityId     Int
  activity       Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId         Int
  user           User     @relation(fields: [userId], references: [id])
  resourceTypeId Int
  resourceType   Master   @relation("ActivityMemberResource", fields: [resourceTypeId], references: [id])

  @@id([activityId, userId])
  @@index([userId])
  @@index([resourceTypeId])
}

model Task {
  id             Int           @id @default(autoincrement())
  taskId         String
  taskName       String
  poRef          String?
  activityId     Int
  activity       Activity      @relation(fields: [activityId], references: [id])
  // The SOW scope line this Activity task delivers (null for pre-contract
  // tasks). Must belong to the Activity's contract.
  contractTaskId Int?
  contractTask   ContractTask? @relation(fields: [contractTaskId], references: [id], onDelete: Restrict)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())

  timesheets Timesheet[]

  @@unique([activityId, contractTaskId])
  @@index([activityId])
  @@index([contractTaskId])
}

model Timesheet {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  clientId    Int
  client      Master   @relation("TimesheetClient", fields: [clientId], references: [id])
  activityId  Int
  activity    Activity @relation(fields: [activityId], references: [id])
  taskId      Int
  task        Task     @relation(fields: [taskId], references: [id])
  date        DateTime
  weekNo      Int
  weekLabel   String
  description String   @db.Text
  hours       Decimal  @db.Decimal(5, 2)
  minutes     Int
  type        String

  // Billing role (RESOURCE_TYPE) of the author on this Activity, snapshotted
  // from ActivityMember when the owner saves, so later membership changes
  // don't rewrite past billing. Null for pre-contract entries.
  resourceTypeId Int?
  resourceType   Master? @relation("TimesheetResourceType", fields: [resourceTypeId], references: [id], onDelete: Restrict)

  sat Decimal @default(0) @db.Decimal(5, 2)
  sun Decimal @default(0) @db.Decimal(5, 2)
  mon Decimal @default(0) @db.Decimal(5, 2)
  tue Decimal @default(0) @db.Decimal(5, 2)
  wed Decimal @default(0) @db.Decimal(5, 2)
  thu Decimal @default(0) @db.Decimal(5, 2)
  fri Decimal @default(0) @db.Decimal(5, 2)

  status        TimesheetStatus @default(DRAFT)
  submittedAt   DateTime?
  approvedAt    DateTime?
  rejectionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sandboxEntries SandboxEntry[]
  // Staff-only discussion; kept in separate tables so employee-facing
  // timesheet queries never load them.
  query          TimesheetQuery?
  comments       TimesheetComment[]

  @@index([userId])
  @@index([date])
  @@index([status])
  @@index([clientId])
  @@index([activityId])
}

model SandboxEntry {
  id          Int        @id @default(autoincrement())
  originalId  Int?
  original    Timesheet? @relation(fields: [originalId], references: [id])
  userId      Int
  clientId    Int
  client      Master     @relation("SandboxClient", fields: [clientId], references: [id])
  activityId  Int
  activity    Activity   @relation("SandboxActivity", fields: [activityId], references: [id])
  taskId      Int
  date        DateTime
  weekNo      Int
  weekLabel   String
  description String     @db.Text
  hours       Decimal    @db.Decimal(5, 2)
  minutes     Int
  type        String

  sat Decimal @default(0) @db.Decimal(5, 2)
  sun Decimal @default(0) @db.Decimal(5, 2)
  mon Decimal @default(0) @db.Decimal(5, 2)
  tue Decimal @default(0) @db.Decimal(5, 2)
  wed Decimal @default(0) @db.Decimal(5, 2)
  thu Decimal @default(0) @db.Decimal(5, 2)
  fri Decimal @default(0) @db.Decimal(5, 2)

  sandboxLabel String
  isDeleted    Boolean  @default(false)
  isAdded      Boolean  @default(false)
  isModified   Boolean  @default(false)
  managerNote  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sandboxLabel])
  @@index([userId])
  @@index([clientId])
  @@index([activityId])
}

model MISReport {
  id           Int      @id @default(autoincrement())
  title        String
  periodStart  DateTime
  periodEnd    DateTime
  sandboxLabel String?
  isFinal      Boolean  @default(false)
  createdById  Int
  createdBy    User     @relation("MISCreator", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  data         Json

  @@index([createdById])
  @@index([periodStart, periodEnd])
}

model UserPermission {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    String
  action    String
  granted   Boolean
  updatedAt DateTime @updatedAt

  @@unique([userId, module, action])
  @@index([userId])
}

model Session {
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

enum QueryStatus {
  OPEN
  RESOLVED
}

// Internal (staff-only) query on a timesheet entry. Posting a comment opens
// it; "Query Resolved" closes it; a later comment reopens it.
model TimesheetQuery {
  timesheetId  Int         @id
  timesheet    Timesheet   @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  status       QueryStatus @default(OPEN)
  openedById   Int
  openedBy     User        @relation("QueryOpenedBy", fields: [openedById], references: [id])
  openedAt     DateTime    @default(now())
  resolvedById Int?
  resolvedBy   User?       @relation("QueryResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt   DateTime?
  updatedAt    DateTime    @updatedAt

  @@index([status])
}

model TimesheetComment {
  id          Int                       @id @default(autoincrement())
  timesheetId Int
  timesheet   Timesheet                 @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  authorId    Int
  author      User                      @relation("CommentAuthor", fields: [authorId], references: [id])
  body        String                    @db.Text
  createdAt   DateTime                  @default(now())
  mentions    TimesheetCommentMention[]

  @@index([timesheetId])
}

model TimesheetCommentMention {
  commentId Int
  comment   TimesheetComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    Int
  user      User             @relation("MentionedUser", fields: [userId], references: [id])

  @@id([commentId, userId])
  @@index([userId])
}
