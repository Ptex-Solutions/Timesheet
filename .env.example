# Copied to .env automatically by `npm run dev:up` (with fresh random secrets).

# Database — defaults match the Docker MySQL from docker-compose.yml (host port 3307).
# To use a MySQL you already run instead (e.g. XAMPP on 3306), change this URL;
# `npm run dev:up` only starts Docker when nothing answers at this host/port.
DATABASE_URL="mysql://root:ptex_root_password@localhost:3307/ptex_db"

# Auth (NextAuth v5). Must be long random strings; dev:up fills these in.
NEXTAUTH_SECRET="replace-with-32-plus-character-random-string-please"
AUTH_SECRET="replace-with-32-plus-character-random-string-please"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

BCRYPT_ROUNDS=12
